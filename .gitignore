# Build artifacts (regenerated by edge_lane_build.sh)
edge_lane.html
.edge_lane_buildstate

# Deploy: secrets + staged frontend output (regenerated by deploy.sh)
deploy/.env
deploy/.env.*
!deploy/.env.example
# DuckDB volume backups produced by `make deploy-data-dump` (machine migration)
deploy/*.tar.gz
dist/
.vercel/

# Local runtime UI config (real keys); generated for deploys, keep example only
market/ui/edgelane.config.js
edgelane.config.js

# Python virtualenvs (never commit)
.venv/
**/.venv/
venv/

# Claude Code agent config, local settings, and audit notes (may contain secrets/PII)
.claude/

# Secrets — never commit your real keys (incl. ANY backup/variant of the configs)
edge_lane_config.config
edgelane_market.config
edge_lane_config.config.*
edgelane_market.config.*
# ...but keep the sanitized templates
!edge_lane_config.config.example
!edgelane_market.config.example

# Backup / scratch files that routinely capture live config (never commit)
*.bak
*.bak-*
*.backup
*.orig
*.save
*~

# Operational notes (may contain account IDs / session notes)
notes.txt
operating_manual.md.pre-reorg-bak

# Built HTML artifacts with inlined keys (regenerated by edge_lane_build.sh)
archive/*.html

# Third-party integration data & private docs — kept out of the public repo
market/extension/
market/tt_prompt.txt
market/REVERSE_ENGINEERING_BASELINE.md
0dte-transcript.txt
market/MANUAL.md
market/backend/README.md

# Root-level screenshots — may contain proprietary trading data or UI
# (assets/*.png favicons are explicitly excluded from this rule)
/*.png
/*.PNG

# Database files
*.duckdb
*.db
# DB / data exports (e.g. deploy/edgelane-data.tar.gz — may hold real trading data)
*.tar.gz

# Runtime logs (SDK logs capture request headers incl. app keys / signatures)
*.log
# Webull OpenAPI SDK local token storage (writes conf/token.txt — a live session token)
conf/

# Claude Code local settings (machine-specific permission allowlists)
.claude/settings.local.json

# Python test compilation
tests/__pycache__/
**/__pycache__/
*.pyc

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Test workspace artifacts
/tmp/babel-test/

# Vendored Webull demo SDK (not part of the app)
webull-openapi-demo-py-us.db3409e012c4c85ef51ebb8e0a765062/

# Local-only Webull prod test harness (reads sibling creds at runtime; never committed)
market/backend/utils/

# Webull SDK local token cache (written relative to cwd) — never commit
conf/
token.txt
.vercel

# Supabase CLI scratch (project ref/org id — not secret, but not source)
supabase/.temp/
.env*
docs/djx_vs_dia.txt
# Competitive strategy analysis — keep out of git history (local planning only)
docs/simmer_competitive_gap.md
