# Level Engine — copy to facades_levels_engine.config (gitignored). See docs/level_engine.md §4.
BACKEND_FEED_URL=http://edgelane-backend:8789/internal/feed
INTERNAL_FEED_TOKEN=
SYMBOL=SPX
TICK_SEC=20
SESSION=09:30-16:00
RATIO_LOCK_TIME=09:35
BUFFER_PTS=2.5
TEST_PTS=6.0
HOLD_MIN=10
GRACE_SEC=60
KNIFE_PTS=5.0
CLUSTER_PTS=5.0
CONTEST_CROSSES=3
CONTEST_WINDOW_MIN=30
DETAIL_WINDOW_MIN=30
EVIDENCE_HALF_LIFE_MIN=15
EVIDENCE_SCALE=1.0
LEAN_LOGODDS=0.5
THIN_FLOOR=0.15
DECIDE_MARGIN=0.20
FLIP_MARGIN=0.30
MIN_DWELL_MIN=5
MAX_REPASS=2
REACH=both
# §12 binary grading: a directional leg wins when spot comes within this many SPX pts of the
# target at any point before the leg ends (≈ $0.50 on SPY — SPY levels are graded in SPX space)
HIT_TOL_PTS=5.0
# §8.4: composite points a challenger must beat the current pick by to replace it
PICK_SWITCH_MARGIN=5.0
# §8.4: R/R must clear a health band edge (0.30 / 0.60) by this much to change band
HEALTH_HYSTERESIS=0.05
# least-privilege Postgres roles (docs §5.1) — never the service_role key
LVL_DB_URL=
LVL_REPLAY_DB_URL=
# §17 admin typo check: a new / edited level more than ±this % from the latest trade is
# not saved until confirmed ("Save anyway" / JSON "confirm": true / levels_cli --force). 0 = off
TYPO_CHECK_PCT=30
READ_PORT=8791
ADMIN_PORT=8790
