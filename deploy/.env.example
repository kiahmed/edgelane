# EdgeLane deploy config — copy to deploy/.env and fill in.
# Consumed by deploy/docker-compose.yml (backend + Cloudflare tunnel) and by
# deploy.sh.  deploy/.env is git-ignored; this .example is the committed template.

# ── Backend container ──
EDGELANE_IMAGE=edgelane-backend:latest
EDGELANE_PORT=8789            # host loopback port for local debugging

# ── Cloudflare tunnel ──
# DEFAULT MODE = free *quick* tunnel (no domain, no token). The cloudflared
# container creates a *.trycloudflare.com URL on each start and publishes it to
# Supabase app_config.api_base; the frontend reads it at runtime. So in quick-
# tunnel mode CF_TUNNEL_TOKEN / EDGELANE_API_BASE stay BLANK — nothing to fill.
#
# Optional STABLE named tunnel (after you own a domain): create a dedicated
# tunnel, route a hostname → http://edgelane-backend:8789, paste its connector
# token here, set EDGELANE_API_BASE below, and swap the cloudflared service in
# docker-compose.yml back to the token form (see the comment there).
CF_TUNNEL_TOKEN=
# Cloudflare API token (account-level) — only needed if you manage a named tunnel.
CF_API_TOKEN=
# Optional — used only by tools/cf_token.py (Turnstile widget management).
# CF_API_TOKEN_TURNSTILE: a token scoped to Turnstile (create via `cf_token.py
#   create-token`); used by `cf_token.py widget` to add allowed hostnames.
# Bootstrap to MINT that token (a scoped token can't create tokens): either
#   CF_API_TOKEN_ADMIN (a token with "User → API Tokens → Edit") or the
#   CF_GLOBAL_API_KEY + CF_EMAIL pair. Leave blank once the Turnstile token exists.
CF_API_TOKEN_TURNSTILE=
CF_API_TOKEN_ADMIN=
CF_GLOBAL_API_KEY=
CF_EMAIL=
# CF account id — needed because a minimal Turnstile token can't enumerate
# accounts. Find it: Cloudflare dashboard → right sidebar "Account ID".
CF_ACCOUNT_ID=

# ── Supabase (DB migrations + URL publisher + Auth site_url sync) ──
# Project ref + Management API token (Dashboard → Account → Access Tokens, sbp_…)
# — used by deploy/db_push.py to apply supabase/migrations/*.sql, AND by deploy.sh
# to PATCH Auth site_url + redirect allow-list to the live Vercel URL each
# frontend deploy (so confirm/magic-link emails don't redirect to localhost:3000).
# Server-only.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
# service_role key — the cloudflared publisher writes app_config.api_base with
# it (compose interpolates it into the container). Server-only; NEVER in a browser.
SUPABASE_SERVICE_KEY=

# ── Frontend (Vercel) ──
VERCEL_PROJECT=edgelane-matrix
# Public HTTPS URL the deployed market UI calls. LEAVE BLANK in quick-tunnel
# mode — the frontend discovers the backend URL at runtime from Supabase
# app_config.api_base. Only set this for a STABLE named tunnel / custom domain,
# in which case it's baked into the frontend at deploy time as a fallback.
EDGELANE_API_BASE=

# ── Frontend public auth keys (baked into dist/edgelane.config.js) ──
# Browser-safe by design: the Supabase anon key is RLS-gated and the Turnstile
# SITE key is public. If the Supabase values are blank the UI runs in dev-bypass
# (no login gate). deploy.sh reuses SUPABASE_URL / SUPABASE_ANON_KEY below if the
# EDGELANE_-prefixed names are unset, so you usually only set them once.
#   NOTE: the Turnstile *SECRET* and Supabase SERVICE_KEY are backend secrets —
#   they live in edgelane_market.config (bind-mounted into the container), NOT here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Cloudflare Turnstile SITE key (Dashboard → Turnstile → your widget). Public.
# Without it the anonymous teaser session is disabled (signed-in users unaffected).
EDGELANE_TURNSTILE_SITE_KEY=
